# The bytes of the CLI jar must not depend on the line endings a checkout happened to use.
*.properties text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
cli/src/main/licenses/* text eol=lf
# Shell scripts must keep LF line endings or the launcher fails on macOS and Linux.
plugin/scripts/session-porter text eol=lf
plugin/tests/*.sh text eol=lf
# The jar the plugin ships is committed as it is, and its checksum file keeps the `sha256sum` format (LF) on every system.
*.jar binary
plugin/lib/*.sha256 text eol=lf
